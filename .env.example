# Скопируйте этот файл в .env и заполните. Настоящий .env
# в репозиторий не попадает — он в .gitignore.

# Служебный токен SourceCraft: им обходится публичный каталог.
# Главная страница → Домой → Доступ → Персональные токены доступа.
SC_TOKEN=

# Вход через Яндекс ID: https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Адрес возврата после входа. Должен совпадать с тем,
# что указан в настройках приложения Яндекс ID.
YANDEX_REDIRECT_URI=http://localhost:8010/auth/callback

# Как часто обходить каталог заново, в часах.
REPOHEALTH_INTERVAL_HOURS=6

# Сколько проектов брать за проход. 0 — весь каталог.
REPOHEALTH_LIMIT=0

# ---------- только для публичного стенда ----------

# Адрес сайта снаружи. Пусто — работаем по http на IP машины.
# С доменом: PUBLIC_SITE=https://ваш.домен — прокси сам получит
# сертификат и будет его продлевать.
PUBLIC_SITE=
ACME_EMAIL=

# На стенде сайт слушает только localhost, наружу смотрит прокси.
WEB_BIND=8010
